generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========== 用户与认证 ==========

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String   @default("SALES")
  phone         String?
  language      String   @default("zh")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salesOrders         Order[]  @relation("SalesOrders")
  faeOrders           Order[]  @relation("FaeOrders")
  configuredTemplates ATCommandTemplate[]
  auditLogs           AuditLog[]
  accounts            Account[]
  sessions            Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ========== 业务核心 ==========

model Order {
  id            String   @id @default(cuid())
  orderNo       String   @unique
  model         String
  quantity      Int
  orderDate     DateTime
  status        String   @default("PENDING_CONFIG")
  customerName  String?
  customerEmail String?
  linkToken     String?  @unique
  linkSentAt    DateTime?
  notes         String?

  salesUserId String
  salesUser   User  @relation("SalesOrders", fields: [salesUserId], references: [id])

  faeUserId String?
  faeUser   User?  @relation("FaeOrders", fields: [faeUserId], references: [id])

  firmwareVersion String?
  shipWithSimCard Boolean?
  shipPoweredOn   Boolean?

  template    ATCommandTemplate?
  submissions CustomerSubmission[]
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== AT 指令模板 ==========

model ATCommandTemplate {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  faeUserId       String
  faeUser         User     @relation(fields: [faeUserId], references: [id])
  firmwareVersion String
  isCustomVersion Boolean  @default(false)
  notes           String?

  parameters ATCommandParameter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ATCommandParameter {
  id           String              @id @default(cuid())
  templateId   String
  template     ATCommandTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  paramKey     String
  displayName  String
  description  String?

  dataType     String   @default("STRING")
  isRequired   Boolean  @default(false)
  defaultValue String?
  unit         String?

  minValue     Float?
  maxValue     Float?
  step         Float?
  enumValues   String?
  regexPattern String?
  regexHint    String?

  sortOrder    Int    @default(0)
  groupName    String?

  values    ATCommandValue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== 客户提交 ==========

model CustomerSubmission {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version        Int      @default(1)
  submitterName  String?
  submitterEmail String?

  status         String   @default("PENDING")
  reviewComment  String?
  reviewDetails  String?
  reviewedBy     String?
  reviewedAt     DateTime?

  paramValues ATCommandValue[]

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orderId, version])
}

model ATCommandValue {
  id           String             @id @default(cuid())
  submissionId String
  submission   CustomerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  parameterId  String
  parameter    ATCommandParameter @relation(fields: [parameterId], references: [id])
  value        String

  @@unique([submissionId, parameterId])
}

// ========== 审计日志 ==========

model AuditLog {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  description String
  metadata    String?
  createdAt   DateTime @default(now())
}

// ========== 系统配置 ==========

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model EmailRecipient {
  id        String   @id @default(cuid())
  role      String
  email     String
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, email])
}

// ========== 型号预设 ==========

model ModelATCommandPreset {
  id         String   @id @default(cuid())
  model      String
  name       String   @default("默认配置")
  isDefault  Boolean  @default(false)
  parameters String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([model, name])
}
